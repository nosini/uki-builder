#!/bin/bash
# uki-snapshots - build and sign Unified Kernel Images for the running
# snapper snapshot and the "pre" snapshots of the last $PREVIOUS zypper
# transactions, newest kernel of each flavor.
#
# Only trusted content goes into an image. The ESP and /boot are outside the
# disk encryption, so nothing is taken from there:
#   kernel    the snapshot's own /usr/lib/modules/<kver>/vmlinuz
#   cmdline   the snapshot's /etc/kernel/cmdline, with root= and
#             rootflags=subvol= computed here
#   initrd    built by dracut on the running system (which booted a signed
#             UKI), cached in $STATE under a hash of everything it depends
#             on besides the kernel (the rpm database and the /etc files in
#             SYSSTATE_PATHS). A zypper "pre" snapshot is the system right
#             before a transaction, so its hash finds the initrd built for
#             exactly that state. A snapshot without one (made before the
#             cache existed, or while it was out of date) gets no UKI.
#
# It creates and deletes only EFI/Linux/$PREFIX-*.efi (and hidden .tmp
# staging files) on the ESP and sets the systemd-boot default entry
# (SET_DEFAULT). It expects sdbootutil to be removed: its boot entries load
# an unsigned initrd from the ESP, and its cleanup deletes UKIs.
#
#   uki-snapshots plan     show what would be done; change nothing
#   uki-snapshots sync     do it (default)
#   uki-snapshots notify   tell logged-in users that the last run failed
#
# Settings can be overridden in /etc/uki-snapshots.conf (bash syntax).

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

# ---- settings ---------------------------------------------------------------
ESP=/boot/efi
KEY=/root/uki-signing/secureboot.key
CERT=/root/uki-signing/secureboot.pem
PREVIOUS=2                   # zypper pre-snapshots to keep besides the current one
PRE_DESCRIPTION='zypp(*'     # glob: which "pre" snapshots are updates (zypper, myrlyn, YaST)
FLAVORS=(default longterm)   # newest kernel of each flavor, where present
DEFAULT_FLAVOR=default       # which of the current system's UKIs boots by default
SET_DEFAULT=yes              # no = leave the default entry alone
PREFIX=uki-snap              # EFI/Linux/$PREFIX-<snapshot>-<kernel>.efi
MARGIN_MIB=64                # always leave at least this much free on the ESP
STATE=/var/lib/uki-snapshots # initrd cache, fingerprints (/var is shared by all snapshots)
SNAPSHOTS=/.snapshots
DRACUT_ARGS=(--reproducible --force --tmpdir /var/tmp --quiet)   # as sdbootutil
# What the initrd depends on besides the kernel. dracut runs again when any
# of it changes, and a snapshot only gets an initrd built for the same state.
SYSSTATE_PATHS=(/usr/lib/sysimage/rpm /etc/crypttab /etc/fstab /etc/dracut.conf
    /etc/dracut.conf.d /etc/modprobe.d /etc/modules-load.d /etc/udev/rules.d
    /etc/vconsole.conf /etc/locale.conf)
IDLE_WAIT_MIN=60             # wait this long for zypper to finish
LOCK=/run/uki-snapshots.lock
ZYPP_PID=/run/zypp.pid
EFIVARS=/sys/firmware/efi/efivars
STUBS=/usr/lib/systemd/boot/efi
SDBOOT=''                    # default: $STUBS/systemd-bootx64.efi
# ESP paths to install systemd-boot to, signed with KEY for the firmware to
# boot directly (no shim); empty = leave the boot loader alone.
#   SDBOOT_DEST=(EFI/systemd/systemd-bootx64.efi)
SDBOOT_DEST=()
# Fallback copies, e.g. the removable-media path. They get a new
# systemd-boot only after the firmware has booted that version once, so a
# broken update still leaves one that works.
#   SDBOOT_FALLBACK=(EFI/BOOT/BOOTX64.EFI)
SDBOOT_FALLBACK=()
NOTIFY=yes                   # desktop notification when the service fails
# Certificates that must not be in db (subject CNs), e.g. the Microsoft
# 3rd-party UEFI CAs once they are removed; finding one fails the service.
#   DB_FORBIDDEN=('Microsoft Corporation UEFI CA 2011' 'Microsoft UEFI CA 2023')
DB_FORBIDDEN=()
LIVE_ROOT=''                 # the running system's root, for tests
# -----------------------------------------------------------------------------

CONF=${UKI_SNAPSHOTS_CONF:-/etc/uki-snapshots.conf}
# shellcheck source=/dev/null
if [[ -f $CONF ]]; then . "$CONF"; fi

SDBOOT=${SDBOOT:-$STUBS/systemd-bootx64.efi}
UKIDIR=$ESP/EFI/Linux
DEFAULT_VAR=$EFIVARS/LoaderEntryDefault-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
DB_VAR=$EFIVARS/db-d719b2cb-3d3a-4596-a3bc-dad00e67656f
LOADER_INFO_VAR=$EFIVARS/LoaderInfo-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
MODE=${1:-sync}
FAILED=0

# Under systemd, stderr already goes to the journal.
log() {
    printf 'uki-snapshots: %s\n' "$*" >&2
    if [[ -z ${JOURNAL_STREAM:-} ]]; then logger -t uki-snapshots -- "$*" 2>/dev/null || :; fi
}
die()  { log "error: $*"; exit 1; }
warn() { log "warning: $*"; FAILED=1; }

xml_field() { sed -n "s:.*<$2>\(.*\)</$2>.*:\1:p" "$1" | head -n1; }
hash()      { sha256sum | cut -d' ' -f1; }

snapshot_root() { echo "$SNAPSHOTS/$1/snapshot"; }

# CUR: the default subvolume's snapshot (what boots next);
# SUBVOL_PREFIX: what comes before ".snapshots/" in subvolume paths ("@/").
read_default() {
    local out
    out=$(btrfs subvolume get-default /) || die "btrfs subvolume get-default / failed"
    [[ $out =~ path\ (.*)\.snapshots/([0-9]+)/snapshot$ ]] \
        || die "default subvolume is not a snapper snapshot: $out"
    SUBVOL_PREFIX=${BASH_REMATCH[1]} CUR=${BASH_REMATCH[2]}
}

# Snapshot the running system booted from (empty if not a snapshot).
booted_snapshot() {
    local fsroot
    fsroot=$(findmnt -no FSROOT /) || return 0
    if [[ $fsroot =~ \.snapshots/([0-9]+)/snapshot$ ]]; then echo "${BASH_REMATCH[1]}"; fi
}

# Newest "pre" snapshots taken by zypp, excluding $1.
previous_snapshots() {
    local cur=$1 info num desc
    for info in "$SNAPSHOTS"/*/info.xml; do
        [[ -f $info ]] || continue
        num=$(xml_field "$info" num)
        [[ $num =~ ^[0-9]+$ && $num != "$cur" ]] || continue
        [[ $(xml_field "$info" type) == pre ]] || continue
        desc=$(xml_field "$info" description)
        # shellcheck disable=SC2053  # PRE_DESCRIPTION is a glob
        [[ $desc == $PRE_DESCRIPTION ]] || continue
        [[ -d $(snapshot_root "$num") ]] || continue
        echo "$num"
    done | sort -rn | head -n "$PREVIOUS"
}

# Newest kernel of flavor $2 installed in snapshot $1 (or nothing).
snapshot_kernel() {
    local k best=''
    for k in "$(snapshot_root "$1")"/usr/lib/modules/*-"$2"/vmlinuz; do
        [[ -f $k ]] || continue
        k=${k%/vmlinuz} k=${k##*/}
        if [[ -z $best || $(printf '%s\n' "$best" "$k" | sort -V | tail -n1) == "$k" ]]; then
            best=$k
        fi
    done
    if [[ -n $best ]]; then echo "$best"; fi
}

# Hash of SYSSTATE_PATHS below root $1 ("" = the running system).
sysstate() {
    local root=$1 p f
    for p in "${SYSSTATE_PATHS[@]}"; do
        if [[ -d $root$p && ! -L $root$p ]]; then
            while IFS= read -r -d '' f; do
                if [[ -L $f ]]; then
                    printf '%s -> %s\n' "${f#"$root"}" "$(readlink "$f")"
                else
                    printf '%s %s\n' "${f#"$root"}" "$(hash <"$f")"
                fi
            done < <(find "$root$p" \( -type f -o -type l \) ! -name '.*' ! -name '__db.*' -print0 | sort -z)
        elif [[ -L $root$p ]]; then
            printf '%s -> %s\n' "$p" "$(readlink "$root$p")"
        elif [[ -f $root$p ]]; then
            printf '%s %s\n' "$p" "$(hash <"$root$p")"
        else
            printf '%s missing\n' "$p"
        fi
    done | hash
}

# sysstate of snapshot $1. Read-only snapshots never change, so theirs is
# cached, keyed by creation time (snapper can reuse the number of a deleted
# snapshot).
snapshot_state() {
    local root cache=$STATE/sysstate/$1 stamp cstamp state
    root=$(snapshot_root "$1")
    if [[ $(btrfs property get -ts "$root" ro 2>/dev/null) != ro=true ]]; then
        sysstate "$root"
        return
    fi
    stamp=$(stat -c %W "$root")
    if [[ -f $cache ]]; then
        read -r cstamp state <"$cache" || :
        if [[ $cstamp == "$stamp" && -n $state ]]; then echo "$state"; return; fi
    fi
    state=$(sysstate "$root")
    if [[ $MODE == sync ]]; then echo "$stamp $state" >"$cache"; fi
    echo "$state"
}

# Initrd for kernel $2 built for sysstate $1 (or nothing).
cached_initrd() {
    local sha f=$STATE/gen/$1/$2
    [[ -f $f ]] || return 0
    read -r sha <"$f" || return 0
    if [[ -f $STATE/initrd/$sha.img ]]; then echo "$STATE/initrd/$sha.img"; fi
}

# Build the initrds of the running system (= snapshot CUR) for its current
# state, unless they are cached already. Sets LIVE to that state.
update_live_initrds() {
    local flavor k sha after
    local -a made=()
    LIVE=$(sysstate "$LIVE_ROOT")
    for flavor in "${FLAVORS[@]}"; do
        k=$(snapshot_kernel "$CUR" "$flavor")
        if [[ -z $k || -n $(cached_initrd "$LIVE" "$k") ]]; then continue; fi
        if [[ $MODE == plan ]]; then
            echo "dracut  $k"
            continue
        fi
        log "building initrd for $k"
        if dracut "${DRACUT_ARGS[@]}" "$WORK/initrd-$k" "$k" </dev/null >"$WORK/dracut.log" 2>&1; then
            made+=("$k")
        else
            cat "$WORK/dracut.log" >&2
            warn "dracut failed for $k"
        fi
    done
    [[ ${#made[@]} -gt 0 ]] || return 0
    # A transaction that started meanwhile may have mixed old and new files.
    after=$(sysstate "$LIVE_ROOT")
    if [[ $after != "$LIVE" ]]; then
        warn "system changed while dracut ran; initrds discarded"
        return 0
    fi
    mkdir -p "$STATE/initrd" "$STATE/gen/$LIVE"
    for k in "${made[@]}"; do
        sha=$(hash <"$WORK/initrd-$k")
        if [[ -f $STATE/initrd/$sha.img ]]; then
            rm -f "$WORK/initrd-$k"
        else
            mv "$WORK/initrd-$k" "$STATE/initrd/$sha.img"
        fi
        echo "$sha" >"$STATE/gen/$LIVE/$k"
        log "initrd for $k: $sha"
    done
}

# Kernel command line for snapshot $1: its /etc/kernel/cmdline, with root=
# and the subvol= in rootflags= set here. root= is spelled
# /dev/disk/by-uuid/: sdbootutil's cleanup (should it ever run again)
# treats entries whose root= matches one of its spellings of this file
# system (UUID=, LABEL=, PARTUUID=, /dev/mapper/..., /dev/dm-N) as its own
# and deletes UKIs it cannot map to a kernel, and this spelling is not among
# them.
make_cmdline() {
    local src word item flags='' rest=''
    local -a words out=()
    src=$(snapshot_root "$1")/etc/kernel/cmdline
    [[ -f $src ]] || return 1
    read -ra words <<<"$(tr '\n' ' ' <"$src")"
    for word in "${words[@]}"; do
        case $word in
            root=*|BOOT_IMAGE=*|initrd=*) ;;
            rootflags=*) flags=${word#rootflags=} ;;
            *) out+=("$word") ;;
        esac
    done
    local IFS=,
    for item in $flags; do
        if [[ $item != subvol=* ]]; then rest=${rest:+$rest,}$item; fi
    done
    IFS=' '
    echo "root=/dev/disk/by-uuid/$ROOT_UUID rootflags=subvol=${SUBVOL_PREFIX}.snapshots/$1/snapshot${rest:+,$rest}${out[*]:+ ${out[*]}}"
}

osrel_value() { sed -n "s/^$2=//p" "$1" | head -n1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"; }

# os-release for the UKI, taken from the snapshot itself.
#  - IMAGE_VERSION "<snapshot>_<kernel>" gives a sensible order within a
#    group (newest snapshot first, default before longterm).
#  - IMAGE_ID is the menu sort-key: "1-uki-current" before "2-uki-previous".
make_osrel() { # snapshot role label kver output
    local src name
    src=$(snapshot_root "$1")/usr/lib/os-release
    [[ -f $src ]] || return 1
    if [[ $2 == current ]]; then
        name=$(osrel_value "$src" NAME)
        name="${name#openSUSE } $(osrel_value "$src" VERSION_ID)"
    else
        name=$3
    fi
    {
        grep -vE '^(PRETTY_NAME|IMAGE_ID|IMAGE_VERSION)=' "$src" || :
        printf 'PRETTY_NAME="UKI: %s (%s)"\n' "${name% }" "$4"
        if [[ $2 == current ]]; then echo IMAGE_ID=1-uki-current; else echo IMAGE_ID=2-uki-previous; fi
        printf 'IMAGE_VERSION=%s_%s\n' "$1" "$4"
    } >"$5"
}

# Changes whenever anything that goes into the UKI changes.
fingerprint() { # kernel initrd cmdline kver osrel
    local s
    {
        echo "linux $(hash <"$1")"
        echo "initrd ${2##*/}"   # named by content hash
        echo "cmdline $3"
        echo "uname $4"
        echo "osrel $(hash <"$5")"
        echo "cert $(hash <"$CERT")"
        for s in "$STUBS"/linux*.efi.stub; do
            if [[ -f $s ]]; then echo "stub ${s##*/} $(hash <"$s")"; fi
        done
        echo "ukify $UKIFY_VERSION"
    } | hash
}

build_uki() { # output kernel initrd cmdline kver osrel
    if ! ukify build --config=/dev/null --linux="$2" --initrd="$3" --cmdline="$4" \
            --uname="$5" --os-release="@$6" --signtool=sbsign \
            --secureboot-private-key="$KEY" --secureboot-certificate="$CERT" \
            --output="$1" </dev/null >"$WORK/ukify.log" 2>&1; then
        cat "$WORK/ukify.log" >&2
        return 1
    fi
    sbverify --cert "$CERT" "$1" >/dev/null 2>&1 || { log "sbverify failed for $1"; return 1; }
}

# Copy to a hidden .tmp name next to the destination first; systemd-boot
# only picks up *.efi, and the old file stays in place until the new one is
# complete.
install_file() {
    local built=$1 dest=$2 tmp need avail
    tmp=$(dirname "$dest")/.${dest##*/}.tmp
    need=$(( $(stat -c %s "$built") + MARGIN_MIB * 1024 * 1024 ))
    avail=$(df --output=avail -B1 "$ESP" | tail -n1)
    (( avail >= need )) || { warn "not enough space on $ESP for ${dest##*/}"; return 1; }
    cp "$built" "$tmp" || return 1
    sync -f "$tmp"
    mv -f "$tmp" "$dest" || return 1
    sync -f "$dest"
}

# systemd-boot of the running system, signed with KEY. openSUSE's build is
# signed for shim; the firmware only needs our signature.
sign_bootloader() {
    local i
    cp "$SDBOOT" "$WORK/sdboot-unsigned.efi" || return 1
    for i in 1 2 3 4; do
        sbattach --remove "$WORK/sdboot-unsigned.efi" >/dev/null 2>&1 || break
    done
    if ! sbsign --key "$KEY" --cert "$CERT" --output "$1" "$WORK/sdboot-unsigned.efi" \
            >"$WORK/sbsign.log" 2>&1; then
        cat "$WORK/sbsign.log" >&2
        return 1
    fi
    sbverify --cert "$CERT" "$1" >/dev/null 2>&1 || { log "sbverify failed for $1"; return 1; }
}

# Version a systemd-boot binary reports as LoaderInfo ("systemd-boot 261.2").
sdboot_version() {
    grep -ao '#### LoaderInfo: [^#]* ####' "$1" 2>/dev/null | head -n1 \
        | sed 's/^#### LoaderInfo: \(.*\) ####$/\1/' || :
}

# Version of the systemd-boot the firmware started this boot.
booted_sdboot_version() {
    [[ -r $LOADER_INFO_VAR ]] || return 0
    tail -c +5 "$LOADER_INFO_VAR" | iconv -f UTF-16LE -t UTF-8 2>/dev/null | tr -d '\0' || :
}

# Install the signed systemd-boot at every SDBOOT_DEST where it is missing
# or out of date (a new systemd-boot or a new certificate), and at every
# SDBOOT_FALLBACK once that version has booted (or if the file is missing).
update_bootloader() {
    local dest fp fpfile version booted role
    local -a dests
    [[ ${#SDBOOT_DEST[@]} -gt 0 || ${#SDBOOT_FALLBACK[@]} -gt 0 ]] || return 0
    if [[ ! -f $SDBOOT ]]; then
        warn "$SDBOOT not found; boot loader not updated"
        return 0
    fi
    fp=$({ hash <"$SDBOOT"; hash <"$CERT"; } | hash)
    version=$(sdboot_version "$SDBOOT")
    booted=$(booted_sdboot_version)
    dests=("${SDBOOT_DEST[@]/#/dest:}" "${SDBOOT_FALLBACK[@]/#/fallback:}")
    for dest in "${dests[@]}"; do
        role=${dest%%:*} dest=${dest#*:}
        fpfile=$STATE/bootloader-${dest//\//_}.fp
        if [[ -f $ESP/$dest && -f $fpfile && $(<"$fpfile") == "$fp" ]]; then
            if [[ $MODE == plan ]]; then echo "keep    $dest"; fi
            continue
        fi
        if [[ $role == fallback && -f $ESP/$dest && ( -z $version || $version != "$booted" ) ]]; then
            if [[ $MODE == plan ]]; then
                echo "hold    $dest  (until ${version:-the new systemd-boot} has booted)"
            fi
            continue
        fi
        if [[ $MODE == plan ]]; then
            echo "sign    ${SDBOOT##*/} -> $dest"
            continue
        fi
        if [[ ! -f $WORK/sdboot.efi ]] && ! sign_bootloader "$WORK/sdboot.efi"; then
            warn "failed to sign ${SDBOOT##*/}"
            return 0
        fi
        mkdir -p "$(dirname "$ESP/$dest")"
        if install_file "$WORK/sdboot.efi" "$ESP/$dest"; then
            echo "$fp" >"$fpfile"
            log "installed signed ${SDBOOT##*/} ${version:+($version) }as $dest"
        else
            warn "failed to install $dest"
        fi
    done
}

# The Secure Boot db must not trust what DB_FORBIDDEN names (a CN appears
# in plain text in the DER certificate).
check_db() {
    local name
    [[ ${#DB_FORBIDDEN[@]} -gt 0 ]] || return 0
    if [[ ! -r $DB_VAR ]]; then
        warn "cannot read the Secure Boot db"
        return 0
    fi
    for name in "${DB_FORBIDDEN[@]}"; do
        if grep -qaF -- "$name" "$DB_VAR"; then
            warn "the Secure Boot db contains \"$name\" again"
        fi
    done
}

# Remove managed files whose names are not among the arguments.
prune() {
    local f base keep
    for f in "$UKIDIR/$PREFIX"-*.efi "$UKIDIR/.$PREFIX"-*.tmp; do
        [[ -e $f ]] || continue
        base=${f##*/}
        for keep in "$@"; do
            if [[ $base == "$keep" ]]; then continue 2; fi
        done
        if [[ $MODE == plan ]]; then
            echo "remove  $base"
        else
            rm -f -- "$f" "$STATE/$base.fp"
            log "removed $base"
        fi
    done
}

# Drop cached initrds that no wanted snapshot state refers to.
gc_cache() {
    local d f n sha
    local -A keep=() used=()
    for n in "$@"; do
        if [[ -n $n ]]; then keep[$n]=1; fi
    done
    for d in "$STATE"/gen/*/; do
        [[ -d $d ]] || continue
        d=${d%/}
        if [[ -z ${keep[${d##*/}]:-} ]]; then rm -rf -- "$d"; fi
    done
    for f in "$STATE"/gen/*/*; do
        if [[ -f $f ]] && read -r sha <"$f"; then used[$sha]=1; fi
    done
    for f in "$STATE"/initrd/*.img; do
        [[ -f $f ]] || continue
        n=${f##*/} n=${n%.img}
        if [[ -z ${used[$n]:-} ]]; then rm -f -- "$f"; fi
    done
    for f in "$STATE"/sysstate/*; do
        [[ -f $f ]] || continue
        if [[ ! -d $SNAPSHOTS/${f##*/} ]]; then rm -f -- "$f"; fi
    done
}

# A transaction changes what the initrd is built from, so wait while zypper
# holds its lock.
busy() {
    local pid
    pid=$(tr -dc 0-9 2>/dev/null <"$ZYPP_PID" || :)
    [[ -n $pid && -d /proc/$pid ]]
}

wait_until_idle() {
    local i
    for ((i = 0; ; i++)); do
        busy || return 0
        (( i < IDLE_WAIT_MIN * 12 )) || return 1
        sleep 5
    done
}

efi_default() {
    [[ -r $DEFAULT_VAR ]] || return 0
    tail -c +5 "$DEFAULT_VAR" | iconv -f UTF-16LE -t UTF-8 2>/dev/null | tr -d '\0' || :
}

# A GVariant string literal, for gdbus.
gvariant_string() {
    local s=${1//\\/\\\\}
    printf "'%s'" "${s//\'/\\\'}"
}

# Tell every user with an active graphical session that the last run failed
# (uki-snapshots-notify.service, started by OnFailure=).
notify_failure() {
    local id user type active last
    local -A seen=()
    [[ $NOTIFY == yes ]] || return 0
    last=$(journalctl -u uki-snapshots.service -b -o cat -n 300 2>/dev/null \
        | grep -E '^uki-snapshots: (warning|error): ' | tail -n1 || :)
    last=${last#uki-snapshots: }
    while read -r id _; do
        [[ -n $id ]] || continue
        type=$(loginctl show-session "$id" -p Type --value 2>/dev/null) || continue
        active=$(loginctl show-session "$id" -p Active --value 2>/dev/null) || continue
        user=$(loginctl show-session "$id" -p Name --value 2>/dev/null) || continue
        [[ $active == yes && ( $type == wayland || $type == x11 ) && -z ${seen[$user]:-} ]] || continue
        seen[$user]=1
        if systemd-run --quiet --collect --wait --user --machine="$user@.host" \
                gdbus call --session --dest org.freedesktop.Notifications \
                --object-path /org/freedesktop/Notifications \
                --method org.freedesktop.Notifications.Notify \
                "'uki-snapshots'" 0 "'dialog-warning'" \
                "$(gvariant_string "Boot images were not updated")" \
                "$(gvariant_string "${last:-see journalctl -u uki-snapshots} (journalctl -u uki-snapshots -b)")" \
                "@as []" "{'urgency': <byte 2>}" 0 >/dev/null 2>&1; then
            log "notified $user"
        else
            log "could not notify $user"
        fi
    done < <(loginctl list-sessions --no-legend 2>/dev/null)
}

# What a run depends on, cheaply: if it changes during a run, run again.
world_sig() {
    {
        btrfs subvolume get-default /
        ls "$SNAPSHOTS"
        find "$LIVE_ROOT/usr/lib/sysimage/rpm" -maxdepth 1 -type f -printf '%p %s %T@\n' | sort
    } 2>/dev/null | hash
}

# ---- main -------------------------------------------------------------------
case $MODE in sync|plan|notify) ;; *) echo "usage: ${0##*/} [sync|plan|notify]" >&2; exit 2 ;; esac
(( EUID == 0 )) || die "must be run as root"
if [[ $MODE == notify ]]; then
    notify_failure
    exit 0
fi
mountpoint -q "$ESP" || die "$ESP is not mounted"
[[ -r $KEY && -r $CERT ]] || die "cannot read $KEY or $CERT"
for c in btrfs findmnt dracut ukify sbsign sbverify bootctl; do
    command -v "$c" >/dev/null || die "$c not found"
done
if [[ ${#SDBOOT_DEST[@]} -gt 0 || ${#SDBOOT_FALLBACK[@]} -gt 0 ]]; then
    command -v sbattach >/dev/null || die "sbattach not found"
fi

# Booted into a read-only snapshot (recovery): its older ukify and stub would
# rebuild every UKI. Not "booted != default": after a rollback the running,
# writable system must still move the default.
if [[ $(btrfs property get -ts / ro 2>/dev/null) == ro=true ]]; then
    log "running from a read-only snapshot; nothing to do"
    exit 0
fi

UKIFY_VERSION=$(ukify --version 2>/dev/null | head -n1 || :)
ROOT_UUID=$(findmnt -no UUID /)
[[ -n $ROOT_UUID ]] || die "cannot determine the UUID of /"

exec 9>"$LOCK"
flock -w 900 9 || die "another run did not finish within 15 minutes"
mkdir -p "$STATE/sysstate" "$UKIDIR"
WORK=$(mktemp -d /var/tmp/uki-snapshots.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

run() {
    local snap flavor k state initrd cmdline label when role fp name i
    local default_name='' olddefault
    local -a prev names=() snaps=() kvers=() initrds=() cmdlines=() labels=() states=() kept=()

    read_default
    BOOTED=$(booted_snapshot)
    if [[ $MODE == plan ]]; then
        if busy; then log "note: zypper is running; this may change"; fi
    elif ! wait_until_idle; then
        warn "zypper still busy after $IDLE_WAIT_MIN minutes; nothing done"
        return 0
    fi

    # dracut only runs on the system it builds for.
    LIVE=''
    if [[ $BOOTED == "$CUR" ]]; then update_live_initrds; fi

    mapfile -t prev < <(previous_snapshots "$CUR")
    log "current snapshot $CUR (booted ${BOOTED:-?}); previous: ${prev[*]:-none}"

    for snap in "$CUR" "${prev[@]}"; do
        if [[ $snap == "$CUR" ]]; then
            label=''
        else
            when=$(xml_field "$SNAPSHOTS/$snap/info.xml" date)
            label="#$snap before update $(date -d "$when UTC" '+%m-%d %H:%M' 2>/dev/null || echo "$when UTC")"
        fi
        if [[ $snap == "$CUR" && -n $LIVE ]]; then
            state=$LIVE
        else
            state=$(snapshot_state "$snap")
        fi
        states+=("$state")
        if ! cmdline=$(make_cmdline "$snap"); then
            warn "snapshot $snap has no /etc/kernel/cmdline; skipped"
            continue
        fi
        for flavor in "${FLAVORS[@]}"; do
            k=$(snapshot_kernel "$snap" "$flavor")
            if [[ -z $k ]]; then
                log "no $flavor kernel in snapshot $snap"
                continue
            fi
            name=$PREFIX-$snap-$k.efi
            initrd=$(cached_initrd "$state" "$k")
            if [[ -z $initrd ]]; then
                if [[ $MODE == plan && $snap == "$CUR" && -n $LIVE ]]; then
                    echo "build   $name  (after dracut)"
                elif [[ $snap == "$CUR" && -f $UKIDIR/$name ]]; then
                    # Built from trusted inputs of an earlier state: better
                    # than nothing until dracut succeeds.
                    warn "no initrd for the current state of $k; keeping $name as it is"
                elif [[ $snap != "$CUR" || -z $LIVE ]]; then
                    log "no initrd built for the state of snapshot $snap; no UKI for $k"
                    continue
                else
                    continue
                fi
                kept+=("$name")
                if [[ $snap == "$CUR" && $flavor == "$DEFAULT_FLAVOR" ]]; then default_name=$name; fi
                continue
            fi
            names+=("$name") snaps+=("$snap") kvers+=("$k") initrds+=("$initrd")
            cmdlines+=("$cmdline") labels+=("$label")
            if [[ $snap == "$CUR" && $flavor == "$DEFAULT_FLAVOR" ]]; then default_name=$name; fi
        done
    done

    # Free space first, but never delete whatever the firmware default points at.
    olddefault=$(efi_default)
    prune "${names[@]}" "${kept[@]}" "$olddefault"

    for i in "${!names[@]}"; do
        name=${names[i]} snap=${snaps[i]} k=${kvers[i]}
        role=previous
        if [[ $snap == "$CUR" ]]; then role=current; fi
        if ! make_osrel "$snap" "$role" "${labels[i]}" "$k" "$WORK/os-release"; then
            warn "snapshot $snap has no os-release; $name skipped"
            continue
        fi
        fp=$(fingerprint "$(snapshot_root "$snap")/usr/lib/modules/$k/vmlinuz" \
            "${initrds[i]}" "${cmdlines[i]}" "$k" "$WORK/os-release")
        if [[ -f $UKIDIR/$name && -f $STATE/$name.fp && $(<"$STATE/$name.fp") == "$fp" ]]; then
            if [[ $MODE == plan ]]; then echo "keep    $name"; fi
            continue
        fi
        if [[ $MODE == plan ]]; then
            echo "build   $name"
            continue
        fi
        if build_uki "$WORK/$name" "$(snapshot_root "$snap")/usr/lib/modules/$k/vmlinuz" \
                "${initrds[i]}" "${cmdlines[i]}" "$k" "$WORK/os-release" \
            && install_file "$WORK/$name" "$UKIDIR/$name"; then
            echo "$fp" >"$STATE/$name.fp"
            log "installed $name"
        else
            warn "failed to build or install $name"
        fi
        rm -f "$WORK/$name"
    done

    # Default entry: the current snapshot's UKI. Without one (e.g. after a
    # rollback to a snapshot that has no initrd) the default stays where it
    # is, which boots the running system rather than nothing.
    if [[ ! -L $(snapshot_root "$CUR")/etc/systemd/system/paths.target.wants/uki-snapshots.path ]]; then
        warn "uki-snapshots.path is not enabled in snapshot $CUR; once booted, its UKIs are no longer updated: run 'make install' there"
    fi
    if [[ $SET_DEFAULT == yes && -z $default_name ]]; then
        warn "no default UKI for snapshot $CUR; default boot entry left at ${olddefault:-unset}"
    elif [[ $SET_DEFAULT == yes && $olddefault != "$default_name" ]]; then
        if [[ $MODE == plan ]]; then
            echo "default $default_name  (currently: ${olddefault:-unset})"
        elif [[ -f $UKIDIR/$default_name ]]; then
            if bootctl set-default "$default_name" >/dev/null; then
                log "default boot entry is now $default_name"
                olddefault=$default_name
            else
                warn "bootctl set-default $default_name failed"
            fi
        else
            warn "$default_name is missing; default boot entry left at ${olddefault:-unset}"
        fi
    fi

    if [[ $MODE == sync ]]; then
        # Second pass: the previous default may be unneeded now.
        prune "${names[@]}" "${kept[@]}" "$olddefault"
        gc_cache "${LIVE:-}" "${states[@]}"
    fi

    update_bootloader
    check_db
}

if [[ $MODE == plan ]]; then
    run
else
    # Snapshots or the rpm database may change while this runs; repeat until
    # they stay the same.
    stable=no
    for attempt in 1 2 3 4 5; do
        FAILED=0   # a later run retries whatever failed, so only the last counts
        before=$(world_sig)
        run
        if [[ $(world_sig) == "$before" ]]; then stable=yes; break; fi
        log "system changed during run $attempt; syncing again"
    done
    if [[ $stable == no ]]; then warn "system still changing after $attempt runs"; fi
fi

exit "$FAILED"
