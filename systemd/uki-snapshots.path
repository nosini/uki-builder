[Unit]
Description=Watch the rpm database and boot configuration to keep signed UKIs in sync

[Path]
# snapshots created (zypper pre/post, rollback) or deleted
PathChanged=/.snapshots
# packages installed or removed (not the whole directory: Index.db is
# rewritten by every root rpm query); the service waits for zypper to finish
PathChanged=/usr/lib/sysimage/rpm/Packages.db
# what goes into the initrd and the command line
PathChanged=/etc/crypttab
PathChanged=/etc/dracut.conf.d
PathChanged=/etc/kernel/cmdline
# systemd-boot and its stubs (re-sign the boot loader, rebuild the UKIs)
PathChanged=/usr/lib/systemd/boot/efi
# rebuild quickly if a UKI goes missing
PathChanged=/boot/efi/EFI/Linux
Unit=uki-snapshots.service

[Install]
WantedBy=paths.target
